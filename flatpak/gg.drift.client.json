{
  "app-id": "gg.drift.client",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "drift-launcher",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--device=dri",
    "--filesystem=home",
    "--filesystem=~/.drift:create"
  ],
  "modules": [
    {
      "name": "drift-client",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 drift-launcher /app/bin/drift-launcher",
        "install -Dm644 gg.drift.client.desktop /app/share/applications/gg.drift.client.desktop",
        "install -Dm644 icons/32x32.png /app/share/icons/hicolor/32x32/apps/gg.drift.client.png",
        "install -Dm644 icons/128x128.png /app/share/icons/hicolor/128x128/apps/gg.drift.client.png",
        "install -Dm644 icons/256x256.png /app/share/icons/hicolor/256x256/apps/gg.drift.client.png",
        "install -Dm644 gg.drift.client.metainfo.xml /app/share/metainfo/gg.drift.client.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "../launcher/src-tauri/target/release/drift-launcher"
        },
        {
          "type": "file",
          "path": "gg.drift.client.desktop"
        },
        {
          "type": "file",
          "path": "gg.drift.client.metainfo.xml"
        },
        {
          "type": "dir",
          "path": "../launcher/src-tauri/icons",
          "dest": "icons"
        }
      ]
    }
  ]
}
