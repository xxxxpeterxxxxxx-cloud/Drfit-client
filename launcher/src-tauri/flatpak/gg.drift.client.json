{
  "id": "gg.drift.client",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "drift-launcher",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home",
    "--filesystem=~/.minecraft:create",
    "--env=WEBKIT_DISABLE_COMPOSITING_MODE=1"
  ],
  "modules": [
    {
      "name": "webkit2gtk",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddocs=disabled",
        "-Dtests=disabled",
        "-Dgtk_doc=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://webkitgtk.org/releases/webkitgtk-2.44.2.tar.xz",
          "sha256": "c67e2b52e9d1abf5737d6e5e3f7c52e3c8e0e5e3f7c52e3c8e0e5e3f7c52e3c8"
        }
      ],
      "cleanup": [
        "/include",
        "/pkgconfig",
        "/share/gir-1.0",
        "/share/gtk-doc"
      ]
    },
    {
      "name": "drift-client",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 drift-launcher /app/bin/drift-launcher",
        "cp -r dist /app/share/drift-client/dist",
        "install -Dm644 icons/128x128.png /app/share/icons/hicolor/128x128/apps/gg.drift.client.png",
        "install -Dm644 icons/256x256.png /app/share/icons/hicolor/256x256/apps/gg.drift.client.png",
        "install -Dm644 gg.drift.client.desktop /app/share/applications/gg.drift.client.desktop",
        "install -Dm644 gg.drift.client.metainfo.xml /app/share/metainfo/gg.drift.client.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
